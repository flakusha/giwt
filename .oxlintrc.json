{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["bin/", ".tmp/", "node_modules/"],
  "jsPlugins": ["./.oxlint/plugins/giwt-style.js"],
  "plugins": ["typescript"],
  "rules": {
    "giwt-style/options-object-params": "warn"
  }
}
