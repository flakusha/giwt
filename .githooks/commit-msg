#!/bin/sh
# commit-msg hook for giwt — LLM Co-Authored-By trailer gate.
#
# Agents keep injecting attribution trailers like
#   Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
# This hook DISCARDS those lines from the commit message before git signs
# and creates the object, so the junk never lands and never gets signed.
#
# Rules:
#   1. A Co-Authored-By line matching the LLM-vendor denylist (claude,
#      anthropic, openai, chatgpt, copilot, gemini, deepseek, mistral,
#      qwen, kimi, glm, z.ai) is stripped + a warning goes to stderr.
#   2. EXEMPTION: a line that contains any entry of ALLOWED_TRAILERS in
#      .credentials.env (comma-separated substrings, case-insensitive,
#      file resolved by walking up from the repo top) is kept verbatim.
#      Use it for intentionally attributed assistant accounts.
#   3. Human Co-Authored-By lines never match the denylist and pass.
#   4. A literal backslash-n / backslash-t sequence in the message is a
#      hallucinated newline — REJECTED (mirrors src/utils/commit-message.ts).
#   5. The subject (first line) may not exceed 72 chars (commitlint
#      subject-max-length) — REJECTED, not rewritten.
#
# Install: git config core.hooksPath .githooks && chmod +x .githooks/commit-msg
# (same setup as .githooks/pre-commit).

set -u

MSG_FILE=${1:-""}
[ -n "$MSG_FILE" ] || exit 0
[ -f "$MSG_FILE" ] || exit 0

# Identity policy + helpers shared with pre-commit (single definition).
HOOK_DIR=$(cd "$(dirname "$0")" && pwd) || exit 1
# shellcheck source=.githooks/identity-gate.sh
. "$HOOK_DIR/identity-gate.sh" || exit 1

# ── Reject hallucinated message shapes (mirrors src/utils/commit-message.ts)
#    before any trailer processing — the author must fix and re-commit. ──
if grep -qF '\n' "$MSG_FILE" || grep -qF '\t' "$MSG_FILE"; then
  printf 'giwt commit-msg: message contains a literal \\n/\\t escape sequence — use a real newline\n' >&2
  exit 1
fi
SUBJECT=$(head -n 1 "$MSG_FILE")
if [ "${#SUBJECT}" -gt 72 ]; then
  printf 'giwt commit-msg: subject is %s chars (max 72) — wrap the detail into the body\n' "${#SUBJECT}" >&2
  exit 1
fi

REPO_TOP=$(git rev-parse --show-toplevel 2>/dev/null) || REPO_TOP=$(pwd)

# LLM vendor denylist (case-insensitive, substring match on the trailer).
DENY='claude|anthropic|openai|chatgpt|copilot|gemini|deepseek|mistral|qwen|kimi|glm|z\.ai'

# ── Resolve .credentials.env (walk up from the repo top, like
#    src/utils/credentials.ts; fall back to $HOME) and read
#    ALLOWED_TRAILERS ──
ALLOW=""
CREDS=""
d=$REPO_TOP
while :; do
  if [ -f "$d/.credentials.env" ]; then
    CREDS=$d/.credentials.env
    break
  fi
  [ "$d" = "/" ] && break
  d=$(dirname "$d")
done
if [ -z "$CREDS" ] && [ -n "${HOME:-}" ] && [ -f "$HOME/.credentials.env" ]; then
  CREDS=$HOME/.credentials.env
fi
if [ -n "$CREDS" ]; then
  ALLOW=$(sed -n 's/^ALLOWED_TRAILERS="\?\([^"]*\)"\?$/\1/p' "$CREDS" | head -n 1)
fi

TRAILERS=$(grep -iE '^co-authored-by:' "$MSG_FILE" || true)
[ -n "$TRAILERS" ] || exit 0

# ── Attribution under an overridden identity is forged: run the pre-commit
#    identity verdict on the RESOLVED identity (not env-var presence — a
#    GIT_CONFIG_GLOBAL pointed at the machine's real config is legitimate).
#    Any fabrication/mismatch FAILs here with the source named above. ──
if ! identity_check_commit; then
  printf 'giwt commit-msg: REFUSED: Co-authored-by trailer(s) under a non-canonical commit identity — attribution written under an overridden identity is forged\n' >&2
  exit 1
fi

TRAILER_LIST=$(mktemp)
PATTERNS=$(mktemp)
trap 'rm -f "$TRAILER_LIST" "$PATTERNS"' EXIT
printf '%s\n' "$TRAILERS" >"$TRAILER_LIST"

STRIPPED=0
while IFS= read -r line; do
  [ -n "$line" ] || continue
  if printf '%s' "$line" | grep -qiE "$DENY"; then
    allowed=0
    if [ -n "$ALLOW" ]; then
      OLD_IFS=$IFS
      IFS=','
      for frag in $ALLOW; do
        frag=$(printf '%s' "$frag" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [ -n "$frag" ] || continue
        if printf '%s' "$line" | grep -qiF -- "$frag"; then
          allowed=1
          break
        fi
      done
      IFS=$OLD_IFS
    fi
    if [ "$allowed" -ne 1 ]; then
      printf '%s\n' "$line" >>"$PATTERNS"
      STRIPPED=$((STRIPPED + 1))
    fi
  fi
done <"$TRAILER_LIST"

# ── Identity gate on the KEPT trailers: each email must match the
#    repo-canonical identity (or carry ALLOWED_TRAILERS consent);
#    placeholders are refused even without a configured canonical. ──
# With zero denylist hits every trailer is kept verbatim (an empty PATTERNS
# file would make `grep -f` match nothing).
if [ "$STRIPPED" -gt 0 ]; then
  KEPT=$(grep -viF -f "$PATTERNS" "$TRAILER_LIST")
else
  KEPT=$(cat "$TRAILER_LIST")
fi
IDENT_STATUS=0
while IFS= read -r line; do
  [ -n "$line" ] || continue
  identity_check_trailer "$line" "$ALLOW" || IDENT_STATUS=1
done <<IDENTITY_KEPT
$KEPT
IDENTITY_KEPT

if [ "$STRIPPED" -gt 0 ]; then
  printf '%s\n' "$TRAILERS" | grep -viF -f "$PATTERNS" | while IFS= read -r kept; do
    printf 'giwt commit-msg: kept allow-listed trailer: %s\n' "$kept" >&2
  done
  grep -viF -f "$PATTERNS" "$MSG_FILE" >"$MSG_FILE.giwt-trailer-clean" 2>/dev/null || true
  mv "$MSG_FILE.giwt-trailer-clean" "$MSG_FILE"

  printf 'giwt commit-msg: stripped %s LLM Co-Authored-By trailer(s):\n' "$STRIPPED" >&2
  sed 's/^/  /' "$PATTERNS" >&2
fi
exit $IDENT_STATUS
